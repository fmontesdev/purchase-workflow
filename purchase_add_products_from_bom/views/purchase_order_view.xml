<odoo>
    <record id="purchase_add_products_from_bom_form_view" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/list/control/create[@name='add_product_control']"
                position="after"
            >
                <button
                    name="%(add_products_from_bom_act_window)d"
                    string="Add Products from BoM"
                    type="action"
                    class="btn-link"
                    context="{'default_purchase_id': parent.id, 'default_currency_id': parent.currency_id}"
                />
            </xpath>
        </field>
    </record>
</odoo>
